{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_id", "purpose", "paths"],
  "properties": {
    "schema_version": {"const": 1},
    "module_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "lifecycle", "provenance"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "lifecycle": {"enum": ["planned", "implemented", "deprecated"]},
          "provenance": {"enum": ["authored", "generated"]},
          "generator": {"type": "string", "minLength": 1},
          "check": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "legacy_consumers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"provenance": {"const": "generated"}}},
            "then": {"required": ["generator", "check"]}
          },
          {
            "if": {"properties": {"lifecycle": {"const": "deprecated"}}},
            "then": {"required": ["legacy_consumers"]}
          }
        ]
      }
    },
    "contracts": {"type": "array", "items": {"type": "string"}},
    "validators": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "runtime_evidence": {"type": "array", "items": {"type": "string"}}
  }
}
