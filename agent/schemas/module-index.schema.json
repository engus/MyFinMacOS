{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modules"],
  "properties": {
    "schema_version": {"const": 1},
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "roots", "entrypoints", "manifest", "dependencies"],
        "properties": {
          "status": {"enum": ["planned", "implemented", "deprecated"]},
          "roots": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "entrypoints": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "manifest": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
